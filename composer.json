{
	"name": "calien/mime-converter",
	"description": "File converter based on mime-type to file extension comparison. Serves image converter by default and automatic tagging for self written converter providers.",
	"type": "typo3-cms-extension",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Markus Hofmann",
			"email": "typo3@calien.de",
			"role": "Developer"
		}
	],
	"require": {
		"php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
		"ext-fileinfo": "*",
		"typo3/cms-core": "^13.4 || ^14.3"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.64",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11",
		"saschaegerer/phpstan-typo3": "^3",
		"typo3/cms-reports": "^13.4 || ^14.3",
		"typo3/testing-framework": "^9"
	},
	"suggest": {
		"typo3/cms-reports": "Adds a system report warning when ImageMagick is not available."
	},
	"autoload": {
		"psr-4": {
			"WebVision\\MimeConverter\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"WebVision\\MimeConverter\\Tests\\": "Tests"
		}
	},
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"typo3/cms-composer-installers": true,
			"typo3/class-alias-loader": true
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "mime_converter",
			"web-dir": ".Build/Web",
			"version": "2.0.0",
			"Package": {
				"providesPackages": {}
			}
		}
	}
}
